# GRAPH SENTINEL Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# FalkorDB Credentials
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=graph_sentinel
USE_IN_MEMORY_FALLBACK=true

# AI Provider Credentials
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Agent & Investigation Settings
MAX_AGENT_STEPS=10
AGENT_TIMEOUT_SECONDS=45
MAX_TRAVERSAL_DEPTH=4
DEMO_AUTO_REPAIR_MODE=false
